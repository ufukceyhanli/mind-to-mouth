# Copy to .env and fill in. EXPO_PUBLIC_* values are baked into the app at build time.

# URL of the coaching Worker (see worker/README.md), for example
# https://mind-to-mouth-coach.<account>.workers.dev
# Leave empty to ship without a coach: talks are then scored by the on-device rubric only.
EXPO_PUBLIC_COACH_URL=

# Optional. Must match the APP_TOKEN secret set on the Worker.
EXPO_PUBLIC_COACH_TOKEN=

# Accounts (required to use the app: Sign in with Apple, Google, email). Without
# these nobody can sign in. From Supabase: Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Personal and development builds only: treat the app as subscribed to Plus, so
# the free plan's limits do not apply (Expo Go, the simulator, a phone build made
# before the subscription exists in App Store Connect). Leave empty for any
# build that goes to TestFlight or the App Store.
EXPO_PUBLIC_PLUS_UNLOCKED=
