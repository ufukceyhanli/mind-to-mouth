# Copy to .env and fill in. Baked into the app at build time so no setup screen is needed.
# Get a free key at https://build.nvidia.com (it starts with nvapi-).
EXPO_PUBLIC_NVIDIA_API_KEY=

# Optional accounts (Sign in with Apple, email). Leave both empty and the app has
# no Account section at all. From Supabase: Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
